# =============================================================================
# Finance OS API — environment variables
# =============================================================================
# Copy to .env and fill in. Never commit .env.

# --- App
NODE_ENV=development
PORT=4000
API_PREFIX=v1
# Comma-separated allowlist for CORS. Use "*" only in dev.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://*

# --- Database
# Local docker postgres example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_os?schema=public

# --- Redis (BullMQ + rate limiting)
REDIS_URL=redis://localhost:6379

# --- JWT
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-bytes-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-bytes-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Sentry (optional in dev)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Feature flags
# Enable demo user creation during seed (only in non-prod)
SEED_DEMO_USER=true
DEMO_USER_EMAIL=demo@finance-os.local
DEMO_USER_PASSWORD=demo-password-12345

# --- Logging
LOG_LEVEL=debug
