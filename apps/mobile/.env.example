# Mobile app environment
# Copy to .env

# Where the API lives. For Expo Go on a phone, use your machine's LAN IP, not localhost.
# Example: http://192.168.1.42:4000/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# Optional Sentry
EXPO_PUBLIC_SENTRY_DSN=

# Optional EAS project id (set after `eas init`)
EXPO_PUBLIC_EAS_PROJECT_ID=
